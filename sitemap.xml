---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | prepend: site.url }}</loc>
    {% if post.date %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endfor %}
  {% assign excluded_paths = "404.html,sitemap.xml,search.json,redirects.json,feed.xml,robots.txt" | split: "," %}
  {% for page in site.pages %}
    {% assign is_excluded = false %}
    {% for excl in excluded_paths %}
      {% if page.path == excl %}{% assign is_excluded = true %}{% endif %}
    {% endfor %}
    {% if page.url contains '/blog/page' %}{% assign is_excluded = true %}{% endif %}
    {% if page.url contains '/assets/' %}{% assign is_excluded = true %}{% endif %}
    {% unless is_excluded or page.sitemap == false %}
  <url>
    <loc>{{ page.url | prepend: site.url }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
